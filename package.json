{
  "name": "branch-review-gutters",
  "displayName": "Branch Review Gutters",
  "description": "Review a branch against its merge base using editor gutter markers, without diff editors.",
  "publisher": "kidsnd274",
  "version": "0.1.2",
  "icon": "assets/icon/icon.png",
  "private": true,
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/Kidsnd274/branch-review-gutters-vscode.git"
  },
  "bugs": {
    "url": "https://github.com/Kidsnd274/branch-review-gutters-vscode/issues"
  },
  "engines": {
    "vscode": "^1.138.0"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "main": "./out/src/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Runs git in the workspace."
    },
    "virtualWorkspaces": false
  },
  "extensionDependencies": [],
  "contributes": {
    "commands": [
      {
        "command": "reviewGutters.toggle",
        "title": "Toggle Review Gutters",
        "category": "Review Gutters"
      },
      {
        "command": "reviewGutters.enable",
        "title": "Enable Review Gutters",
        "category": "Review Gutters"
      },
      {
        "command": "reviewGutters.disable",
        "title": "Disable Review Gutters",
        "category": "Review Gutters"
      },
      {
        "command": "reviewGutters.selectBase",
        "title": "Select Base Branch or Commit...",
        "category": "Review Gutters"
      },
      {
        "command": "reviewGutters.autoDetectBase",
        "title": "Auto-detect Base Branch",
        "category": "Review Gutters"
      },
      {
        "command": "reviewGutters.refresh",
        "title": "Refresh Comparison",
        "category": "Review Gutters",
        "icon": "$(refresh)"
      },
      {
        "command": "reviewGutters.clearBase",
        "title": "Clear Base Selection",
        "category": "Review Gutters"
      },
      {
        "command": "reviewGutters.showMenu",
        "title": "Review Gutters Menu",
        "category": "Review Gutters"
      },
      {
        "command": "reviewGutters.showChangedFiles",
        "title": "Show Changed Files...",
        "category": "Review Gutters"
      },
      {
        "command": "reviewGutters.setTreeMode",
        "title": "Show as Tree",
        "category": "Review Gutters",
        "icon": "$(list-tree)"
      },
      {
        "command": "reviewGutters.setListMode",
        "title": "Show as List",
        "category": "Review Gutters",
        "icon": "$(list-flat)"
      },
      {
        "command": "reviewGutters.nextChangedFile",
        "title": "Next Changed File",
        "category": "Review Gutters"
      },
      {
        "command": "reviewGutters.previousChangedFile",
        "title": "Previous Changed File",
        "category": "Review Gutters"
      },
      {
        "command": "reviewGutters.nextChange",
        "title": "Next Change in File",
        "category": "Review Gutters"
      },
      {
        "command": "reviewGutters.previousChange",
        "title": "Previous Change in File",
        "category": "Review Gutters"
      },
      {
        "command": "reviewGutters.openBaseVersion",
        "title": "Open Base Version of Current File",
        "category": "Review Gutters"
      },
      {
        "command": "reviewGutters.compareWithBase",
        "title": "Compare Current File with Base",
        "category": "Review Gutters"
      },
      {
        "command": "reviewGutters.showLog",
        "title": "Show Log",
        "category": "Review Gutters"
      },
      {
        "command": "reviewGutters.openFromTree",
        "title": "Open Changed File",
        "category": "Review Gutters"
      },
      {
        "command": "reviewGutters.openBaseFromTree",
        "title": "Open Base Version",
        "category": "Review Gutters"
      },
      {
        "command": "reviewGutters.compareFromTree",
        "title": "Compare with Base",
        "category": "Review Gutters"
      },
      {
        "command": "reviewGutters.copyTreePath",
        "title": "Copy Path",
        "category": "Review Gutters"
      }
    ],
    "configuration": {
      "title": "Branch Review Gutters",
      "properties": {
        "reviewGutters.baseBranches": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "main",
            "master"
          ],
          "description": "Candidate base branch names for auto-detection, in order of preference."
        },
        "reviewGutters.remote": {
          "type": "string",
          "default": "origin",
          "description": "Remote used for <remote>/<branch> fallbacks and for the remote default branch."
        },
        "reviewGutters.explorerBadges": {
          "type": "boolean",
          "default": true,
          "description": "Show badges and colours for changed files in the Explorer."
        },
        "reviewGutters.viewMode": {
          "type": "string",
          "enum": [
            "tree",
            "list"
          ],
          "default": "tree",
          "description": "How the Changed Files view groups changed files. The view's title-bar toggle overrides this for the current workspace."
        },
        "reviewGutters.autoReveal": {
          "type": "boolean",
          "default": true,
          "description": "Reveal the current file in the Changed Files view when switching editors."
        },
        "reviewGutters.maxFileSizeKB": {
          "type": "number",
          "default": 1024,
          "description": "Skip files whose base version is larger than this, in kilobytes."
        },
        "reviewGutters.excludeGlobs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Repository-relative glob patterns that are never decorated."
        },
        "reviewGutters.logLevel": {
          "type": "string",
          "enum": [
            "info",
            "debug"
          ],
          "default": "info",
          "description": "Verbosity of the Branch Review Gutters output channel."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "reviewGutters",
          "title": "Branch Review",
          "icon": "assets/icon/activitybar.svg"
        }
      ]
    },
    "views": {
      "reviewGutters": [
        {
          "id": "reviewGutters.changedFiles",
          "name": "Changed Files",
          "hideWhenEmpty": false
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "reviewGutters.changedFiles",
        "when": "!reviewGutters.hasRepository",
        "contents": "This window has no git repository.\n[Check Again](command:reviewGutters.refresh)"
      },
      {
        "view": "reviewGutters.changedFiles",
        "when": "reviewGutters.hasRepository && !reviewGutters.enabled",
        "contents": "Review is switched off for this repository.\n[Enable Review Gutters](command:reviewGutters.enable)\n[Select Base Branch or Commit...](command:reviewGutters.selectBase)"
      },
      {
        "view": "reviewGutters.changedFiles",
        "when": "reviewGutters.hasRepository && reviewGutters.enabled && !reviewGutters.hasBase",
        "contents": "No base branch could be resolved for this repository.\n[Select Base Branch or Commit...](command:reviewGutters.selectBase)\n[Auto-detect Base Branch](command:reviewGutters.autoDetectBase)"
      },
      {
        "view": "reviewGutters.changedFiles",
        "when": "reviewGutters.hasRepository && reviewGutters.enabled && reviewGutters.hasBase && !reviewGutters.hasChanges",
        "contents": "Nothing changed against the base.\n[Refresh Comparison](command:reviewGutters.refresh)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "reviewGutters.showMenu",
          "when": "false"
        },
        {
          "command": "reviewGutters.openFromTree",
          "when": "false"
        },
        {
          "command": "reviewGutters.openBaseFromTree",
          "when": "false"
        },
        {
          "command": "reviewGutters.compareFromTree",
          "when": "false"
        },
        {
          "command": "reviewGutters.copyTreePath",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "reviewGutters.setListMode",
          "when": "view == reviewGutters.changedFiles && reviewGutters.viewMode == tree",
          "group": "navigation@1"
        },
        {
          "command": "reviewGutters.setTreeMode",
          "when": "view == reviewGutters.changedFiles && reviewGutters.viewMode == list",
          "group": "navigation@1"
        },
        {
          "command": "reviewGutters.refresh",
          "when": "view == reviewGutters.changedFiles",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "reviewGutters.openBaseFromTree",
          "when": "view == reviewGutters.changedFiles && viewItem =~ /^(modified|typeChanged|renamed)$/",
          "group": "reviewGutters@1"
        },
        {
          "command": "reviewGutters.compareFromTree",
          "when": "view == reviewGutters.changedFiles && viewItem =~ /^(modified|typeChanged|renamed)$/",
          "group": "reviewGutters@2"
        },
        {
          "command": "reviewGutters.copyTreePath",
          "when": "view == reviewGutters.changedFiles && viewItem =~ /^(added|untracked|modified|typeChanged|renamed)$/",
          "group": "reviewGutters@3"
        }
      ]
    }
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('out', { recursive: true, force: true })\"",
    "compile": "npm run clean && tsc -p .",
    "watch": "tsc -p . --watch",
    "test": "npm run compile && node --test \"out/test/*.test.js\"",
    "icon": "./scripts/build-icon.sh",
    "package": "vsce package --no-dependencies",
    "build": "./scripts/build-vsix.sh",
    "install-local": "code --install-extension branch-review-gutters-0.1.2.vsix --force"
  },
  "devDependencies": {
    "@types/node": "^24.5.0",
    "@types/vscode": "1.138.0",
    "@vscode/vsce": "^4.0.0",
    "typescript": "^5.9.2"
  }
}
